# Server Configuration
PORT=5001
NODE_ENV=production

# JWT Configuration (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/auth/google/callback

# Frontend URL (your Vercel deployment URL - for CORS and redirects)
FRONTEND_URL=https://your-app.vercel.app

# Python AI Service URL (your Render AI service URL)
AI_SERVICE_URL=https://your-ai-service.onrender.com

# Database
DATABASE_PATH=./database.sqlite

# Encryption (generate with: openssl rand -hex 16)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
ENCRYPTION_IV=your-16-byte-hex-iv

# Email Configuration (Gmail App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM_NAME=VitalFlow

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# SMS Configuration (Fast2SMS for India)
FAST2SMS_API_KEY=your_fast2sms_key
